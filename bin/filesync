#!/usr/bin/env bash
set -euo pipefail

# Resolve install root when PREFIX/bin/filesync is a symlink (dirname "$0" would be wrong).
_dispatch_self="${BASH_SOURCE[0]}"
if _rp="$(readlink -f "$_dispatch_self" 2>/dev/null)"; then
  _dispatch_self="$_rp"
elif command -v realpath >/dev/null 2>&1 && _rp="$(realpath "$_dispatch_self" 2>/dev/null)"; then
  _dispatch_self="$_rp"
fi
ROOT="$(cd "$(dirname "$_dispatch_self")/.." && pwd)"

FILESYNC_VERSION="unknown"
if [[ -r "$ROOT/share/VERSION" ]]; then
  FILESYNC_VERSION="$(tr -d '\r\n' <"$ROOT/share/VERSION")"
fi

# shellcheck source=/dev/null
source "$ROOT/lib/colors.sh"

print_header() {
  echo "------------------" >&2
  echo -e "${BOLD}${WHITE}$1${NC}" >&2
  echo "------------------" >&2
}

help() {
  echo "filesync — sync tracked files with master repos (.filesync/ config)"
  echo ""
  echo "  filesync init [directory]   # create .filesync/ here (default: cwd); establishes project root"
  echo "  filesync en|enable | dis|disable"
  echo "  filesync progress [hidden|bar|percent]   # TTY progress on long loops (default percent; legacy show/hide-progress)"
  echo "  filesync pm|path-mode [relative|absolute]   # show or set repo path resolution mode"
  echo "  filesync s|sync [--repo=name] [--file=path_fragment] [--dry-run|--force|--showall|--status=a,b,...|--include-detached|...]"
  echo "  filesync c|check [--repo=name] [--file=path_fragment] [--status=a,b,...]"
  echo "  filesync lr|repos|list-repos [--repo=name]   # list repos"
  echo "  filesync lf|files|list-files [--repo=name] [--file=path_fragment] [--status=a,b,...] [--include-detached]"
  echo "  filesync af|add-file <repo> <path_in_repo>[:<local_path>] ... [--mark-master] [--also=repo1,repo2]"
  echo "           # path_in_repo = file under the repo checkout; omit :local_path if project uses the same path"
  echo "  filesync am|add-master <repo> <local_path>[:<path_in_repo>] ... [--also=...]"
  echo "           # promote local file to master; omit :path_in_repo if master path matches local_path"
  echo "  filesync p|push <local_path> [local_path ...]"
  echo "  filesync dd|detach <local_path> [local_path ...]"
  echo "  filesync da|attach <local_path> [local_path ...]   # re-couple detached rows + check each"
  echo "  filesync rm|remove <local_path> [local_path ...]   # drop row; strip clone/detached marker, keep master"
  echo "  filesync ar|add-repo                 # interactive add repo"
  echo "  filesync er|edit-repo <name> [--rename=] [--path=] [--url=] [--branch=]"
  echo "           # edit repos.json; rename updates repo_name in all files.json rows"
  echo "  filesync update [--check] [--apply] [-y]   # newer release from GitHub (git or .deb)"
  echo "  filesync help"
  echo ""
  echo "  sync / list-files --status= uses comma-separated tokens (OR). Special: unset (empty field),"
  echo "    all (non-detached only), error (any error_* status). Token detached matches detached rows;"
  echo "    --include-detached also lets all (and sync default) include detached. Default sync: unset+sync_required."
  echo "    Other values: synced sync_required local_newer conflict detached; error_* from check (see docs)."
  echo ""
  echo "Config: discovered like git — walk up from the current directory for .filesync/"
  echo "  (.filesync/config.json, repos.json, files.json — see docs/configuration.md)"
}

main() {
  if [[ $# -eq 1 && ($1 == '-V' || $1 == '--version') ]]; then
    printf '%s\n' "filesync ${FILESYNC_VERSION}"
    exit 0
  fi
  if [[ $# -eq 0 ]]; then
    help
    exit 0
  fi
  local sub="$1"
  shift

  case "$sub" in
    sync|s)
      print_header "FILESYNC: sync from master"
      exec "$ROOT/commands/sync.sh" "$@"
      ;;
    check|c)
      print_header "FILESYNC: check"
      exec "$ROOT/commands/check.sh" "$@"
      ;;
    init)
      print_header "FILESYNC: init"
      exec "$ROOT/commands/init.sh" "$@"
      ;;
    add-file|af|add)
      exec "$ROOT/commands/add.sh" "$@"
      ;;
    add-master|am)
      exec "$ROOT/commands/add-master.sh" "$@"
      ;;
    push|p)
      exec "$ROOT/commands/push.sh" "$@"
      ;;
    detach|dd)
      exec "$ROOT/commands/detach.sh" "$@"
      ;;
    attach|da)
      exec "$ROOT/commands/attach.sh" "$@"
      ;;
    remove|rm)
      exec "$ROOT/commands/rm.sh" "$@"
      ;;
    add-repo|ar|repo)
      exec "$ROOT/commands/add-repo.sh" "$@"
      ;;
    edit-repo|er|repo-edit)
      exec "$ROOT/commands/edit-repo.sh" "$@"
      ;;
    list-repos|repos|lr)
      exec "$ROOT/commands/list.sh" list-repos "$@"
      ;;
    list-files|list|lf|files)
      exec "$ROOT/commands/list.sh" list-files "$@"
      ;;
    enable|en)
      exec "$ROOT/commands/enable-disable.sh" enable
      ;;
    disable|dis)
      exec "$ROOT/commands/enable-disable.sh" disable
      ;;
    progress)
      exec "$ROOT/commands/progress.sh" "$@"
      ;;
    show-progress)
      exec "$ROOT/commands/progress.sh" bar
      ;;
    hide-progress)
      exec "$ROOT/commands/progress.sh" hidden
      ;;
    path-mode|pm)
      exec "$ROOT/commands/path-mode.sh" "$@"
      ;;
    update)
      exec "$ROOT/commands/update.sh" "$@"
      ;;
    help|-h|--help)
      help
      ;;
    *)
      if [[ "$sub" == -* ]]; then
        print_header "FILESYNC: sync from master"
        exec "$ROOT/commands/sync.sh" "$sub" "$@"
      fi
      echo -e "${RED}Unknown subcommand: $sub${NC}" >&2
      help >&2
      exit 1
      ;;
  esac
}

main "$@"

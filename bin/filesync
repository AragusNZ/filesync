#!/usr/bin/env bash
set -euo pipefail

# Resolve install root when PREFIX/bin/filesync is a symlink (dirname "$0" would be wrong).
_dispatch_self="${BASH_SOURCE[0]}"
if _rp="$(readlink -f "$_dispatch_self" 2>/dev/null)"; then
  _dispatch_self="$_rp"
elif command -v realpath >/dev/null 2>&1 && _rp="$(realpath "$_dispatch_self" 2>/dev/null)"; then
  _dispatch_self="$_rp"
else
  # Fallback when readlink lacks -f and realpath is missing: chase symlinks by hand (POSIX readlink).
  _p="$_dispatch_self"
  case "$_p" in
    /*) ;;
    *) _p="$(cd "$(dirname "$_p")" && pwd)/$(basename "$_p")" ;;
  esac
  _i=0
  while [[ -L "$_p" ]] && [[ "$_i" -lt 64 ]]; do
    _t="$(readlink "$_p" 2>/dev/null)" || break
    if [[ "$_t" == /* ]]; then
      _p="$_t"
    else
      _p="$(cd "$(dirname "$_p")" && pwd)/$_t"
    fi
    _i=$((_i + 1))
  done
  _dispatch_self="$(cd "$(dirname "$_p")" && pwd -P)/$(basename "$_p")"
fi
ROOT="$(cd "$(dirname "$_dispatch_self")/.." && pwd)"

FILESYNC_VERSION="unknown"
if [[ -r "$ROOT/share/VERSION" ]]; then
  FILESYNC_VERSION="$(tr -d '\r\n' <"$ROOT/share/VERSION")"
fi

# shellcheck source=/dev/null
source "$ROOT/lib/colors.sh"
# shellcheck source=/dev/null
source "$ROOT/lib/compound-dispatch.sh"

main() {
  if [[ $# -eq 1 && ($1 == '-V' || $1 == '--version') ]]; then
    printf '%s\n' "filesync ${FILESYNC_VERSION}"
    exit 0
  fi
  if [[ $# -eq 0 ]]; then
    exec "$ROOT/commands/help.sh"
  fi
  local sub="$1"
  shift

  case "$sub" in
    sync|s)
      exec "$ROOT/commands/sync.sh" "$@"
      ;;
    check|c)
      exec "$ROOT/commands/check.sh" "$@"
      ;;
    init)
      exec "$ROOT/commands/init.sh" "$@"
      ;;
    list|l)
      filesync_route_list "$@"
      ;;
    add|a)
      filesync_route_add "$@"
      ;;
    detach|d)
      filesync_route_detach "$@"
      ;;
    attach|da)
      filesync_route_attach "$@"
      ;;
    remove|rm)
      filesync_route_remove "$@"
      ;;
    new|n)
      filesync_route_new "$@"
      ;;
    edit|e)
      filesync_route_edit "$@"
      ;;
    push)
      exec "$ROOT/commands/push.sh" "$@"
      ;;
    config)
      exec "$ROOT/commands/config.sh" "$@"
      ;;
    migrate)
      exec "$ROOT/commands/migrate.sh" "$@"
      ;;
    handle-missing)
      exec "$ROOT/commands/handle-missing.sh" "$@"
      ;;
    doctor)
      exec "$ROOT/commands/doctor.sh" "$@"
      ;;
    update)
      exec "$ROOT/commands/update.sh" "$@"
      ;;
    info|i)
      filesync_route_info "$@"
      ;;
    retarget)
      filesync_route_retarget "$@"
      ;;
    help|-h|--help)
      exec "$ROOT/commands/help.sh"
      ;;
    *)
      if [[ "$sub" == -* ]]; then
        exec "$ROOT/commands/sync.sh" "$sub" "$@"
      fi
      echo -e "${RED}Unknown subcommand: $sub${NC}" >&2
      "$ROOT/commands/help.sh" >&2
      exit 1
      ;;
  esac
}

main "$@"
